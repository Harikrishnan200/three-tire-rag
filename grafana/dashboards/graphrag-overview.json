{
  "title": "GraphRAG Overview",
  "uid": "graphrag-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "title": "Requests/sec",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(rag_requests_total[5m]))" }]
    },
    {
      "id": 2,
      "title": "p95 / p99 Request Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(rag_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum(rate(rag_request_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 3,
      "title": "Error Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(rate(rag_requests_total{status=\"error\"}[5m])) / sum(rate(rag_requests_total[5m]))" }]
    },
    {
      "id": 4,
      "title": "LLM / Vector / Graph Latency (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(rag_llm_latency_seconds_bucket[5m])) by (le))", "legendFormat": "LLM" },
        { "expr": "histogram_quantile(0.95, sum(rate(rag_vector_search_latency_seconds_bucket[5m])) by (le))", "legendFormat": "Vector" },
        { "expr": "histogram_quantile(0.95, sum(rate(rag_graph_search_latency_seconds_bucket[5m])) by (le))", "legendFormat": "Graph" }
      ]
    },
    {
      "id": 5,
      "title": "Cache Hit Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(rate(rag_cache_hits_total[5m])) / (sum(rate(rag_cache_hits_total[5m])) + sum(rate(rag_cache_misses_total[5m])))" }
      ]
    },
    {
      "id": 6,
      "title": "Document Ingestion Success/Failure",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        { "expr": "sum(rate(document_ingestion_total[5m]))", "legendFormat": "attempts" },
        { "expr": "sum(rate(document_ingestion_failures_total[5m]))", "legendFormat": "failures" }
      ]
    },
    {
      "id": 7,
      "title": "Retrieval Tier Usage",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [{ "expr": "sum by (tier) (rag_requests_total)" }]
    }
  ]
}
